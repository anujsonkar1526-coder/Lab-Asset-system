<%- include('../partials/header') %>

<div class="form-container-card">
  <div class="form-header">
    <a href="/maintenance" class="back-link">&larr; Back to Maintenance Logs</a>
    <h1 class="form-title">🛠️ Log Equipment Service / Maintenance</h1>
    <p class="form-subtitle">Record maintenance details, technician costs, and set next servicing schedule.</p>
  </div>

  <form action="/maintenance" method="POST" class="asset-form">
    <div class="form-grid">
      <!-- Target Asset Selection -->
      <div class="form-group" style="grid-column: 1 / -1;">
        <label for="assetId" class="form-label">
          Equipment Asset <span class="required">*</span>
        </label>
        <select id="assetId" name="assetId" class="form-control" required>
          <% if (!preselectedAsset) { %>
            <option value="">-- Choose Equipment Asset --</option>
          <% } %>
          <% assets.forEach(a => { %>
            <option value="<%= a._id %>" <%= (preselectedAssetId && preselectedAssetId.toString() === a._id.toString()) ? 'selected' : '' %>>
              <%= a.name %> (<%= a.assetTag %>) — Lab: <%= a.lab %> (Current Condition: <%= a.condition %>)
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Service Date -->
      <div class="form-group">
        <label for="serviceDate" class="form-label">Service / Repair Date <span class="required">*</span></label>
        <% const today = new Date().toISOString().split('T')[0]; %>
        <input
          type="date"
          id="serviceDate"
          name="serviceDate"
          class="form-control"
          value="<%= typeof formData !== 'undefined' && formData.serviceDate ? formData.serviceDate : today %>"
          required
        >
      </div>

      <!-- Cost -->
      <div class="form-group">
        <label for="cost" class="form-label">Maintenance Cost (₹ INR) <span class="required">*</span></label>
        <input
          type="number"
          step="0.01"
          min="0"
          id="cost"
          name="cost"
          class="form-control"
          placeholder="e.g. 1500"
          value="<%= typeof formData !== 'undefined' && formData.cost !== undefined ? formData.cost : '' %>"
          required
        >
      </div>

      <!-- Next Service Due Date -->
      <div class="form-group">
        <label for="nextServiceDue" class="form-label">Next Service Due Date <span class="required">*</span></label>
        <input
          type="date"
          id="nextServiceDue"
          name="nextServiceDue"
          class="form-control"
          value="<%= typeof formData !== 'undefined' && formData.nextServiceDue ? formData.nextServiceDue : '' %>"
          required
        >
        <small class="form-text">Scheduled date for subsequent maintenance/calibration.</small>
      </div>

      <!-- Vendor / Technician -->
      <div class="form-group">
        <label for="technician" class="form-label">Technician / Service Vendor</label>
        <input
          type="text"
          id="technician"
          name="technician"
          class="form-control"
          placeholder="e.g. Rigol Authorized Service Center, Internal Tech Team"
          value="<%= typeof formData !== 'undefined' && formData.technician ? formData.technician : 'Authorized Service Center' %>"
        >
      </div>

      <!-- Status -->
      <div class="form-group">
        <label for="status" class="form-label">Service Status</label>
        <select id="status" name="status" class="form-control">
          <option value="Completed" selected>Completed (Service finished)</option>
          <option value="In Progress">In Progress (Currently under repair)</option>
          <option value="Scheduled">Scheduled (Planned future service)</option>
        </select>
      </div>

      <!-- Update Asset Condition -->
      <div class="form-group">
        <label for="updateCondition" class="form-label">Update Equipment Condition</label>
        <select id="updateCondition" name="updateCondition" class="form-control">
          <option value="OK" selected>Set Condition to: OK (Operational)</option>
          <option value="Maintenance">Set Condition to: Maintenance (Under Service)</option>
          <option value="Damaged">Set Condition to: Damaged</option>
        </select>
      </div>
    </div>

    <!-- Description -->
    <div class="form-group" style="margin-top: 1rem;">
      <label for="description" class="form-label">Maintenance / Repair Description <span class="required">*</span></label>
      <textarea
        id="description"
        name="description"
        rows="3"
        class="form-control"
        placeholder="Detail the work performed (e.g. Optical sensor alignment, probe replacement, capacitor repair, routine calibration, etc.)"
        required
      ><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
    </div>

    <div class="form-actions">
      <a href="/maintenance" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Save Maintenance Log</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
