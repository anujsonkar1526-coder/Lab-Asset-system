<%- include('../partials/header') %>

<div class="details-container">
  <div class="details-header">
    <a href="/assets" class="back-link">&larr; Back to Assets List</a>
    <div class="header-action-row">
      <div>
        <span class="tag-badge-lg"><%= asset.assetTag %></span>
        <h1 class="details-title"><%= asset.name %></h1>
      </div>
      <div class="header-buttons">
        <a href="/assets/<%= asset._id %>/edit" class="btn btn-outline-primary">
          ✏️ Edit Asset
        </a>
        <form action="/assets/<%= asset._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this asset?');">
          <button type="submit" class="btn btn-outline-danger">
            🗑️ Delete Asset
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="details-grid">
    <!-- Main Asset Information Card -->
    <div class="card details-card">
      <h2 class="card-title">Asset Information</h2>
      <div class="info-list">
        <div class="info-item">
          <span class="info-label">Asset Tag:</span>
          <span class="info-value"><code><%= asset.assetTag %></code></span>
        </div>
        <div class="info-item">
          <span class="info-label">Equipment Name:</span>
          <span class="info-value"><strong><%= asset.name %></strong></span>
        </div>
        <div class="info-item">
          <span class="info-label">Category:</span>
          <span class="info-value"><span class="category-pill"><%= asset.category %></span></span>
        </div>
        <div class="info-item">
          <span class="info-label">Lab Location:</span>
          <span class="info-value"><%= asset.lab %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Condition:</span>
          <span class="info-value">
            <% if (asset.condition === 'OK') { %>
              <span class="badge badge-condition-ok">OK (Operational)</span>
            <% } else if (asset.condition === 'Damaged') { %>
              <span class="badge badge-condition-damaged">Damaged (Needs Repair)</span>
            <% } else if (asset.condition === 'Lost') { %>
              <span class="badge badge-condition-lost">Lost</span>
            <% } else if (asset.condition === 'Maintenance') { %>
              <span class="badge badge-condition-maintenance">Under Maintenance</span>
            <% } %>
          </span>
        </div>
        <div class="info-item">
          <span class="info-label">Registered On:</span>
          <span class="info-value"><%= new Date(asset.createdAt).toLocaleDateString() %></span>
        </div>
        <div class="info-item">
          <span class="info-label">Last Updated:</span>
          <span class="info-value"><%= new Date(asset.updatedAt).toLocaleDateString() %></span>
        </div>
      </div>
    </div>

    <!-- Inventory & Stock Status Card -->
    <div class="card details-card">
      <h2 class="card-title">Inventory & Availability</h2>
      <div class="stock-metrics">
        <div class="metric-box">
          <span class="metric-number"><%= asset.totalQuantity %></span>
          <span class="metric-label">Total Units</span>
        </div>
        <div class="metric-box">
          <span class="metric-number <%= asset.availableQuantity === 0 ? 'text-danger' : 'text-success' %>">
            <%= asset.availableQuantity %>
          </span>
          <span class="metric-label">Available Units</span>
        </div>
        <div class="metric-box">
          <span class="metric-number text-warning">
            <%= asset.totalQuantity - asset.availableQuantity %>
          </span>
          <span class="metric-label">Issued / Reserved</span>
        </div>
      </div>

      <!-- Stock Availability Visual Meter -->
      <div class="stock-meter-container">
        <% const pct = asset.totalQuantity > 0 ? Math.round((asset.availableQuantity / asset.totalQuantity) * 100) : 0; %>
        <div class="meter-label-row">
          <span>Availability Ratio</span>
          <span><strong><%= pct %>%</strong></span>
        </div>
        <div class="meter-bar-bg">
          <div class="meter-bar-fill <%= pct > 50 ? 'fill-high' : (pct > 20 ? 'fill-mid' : 'fill-low') %>" style="width: <%= pct %>%;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================= -->
  <!-- MAINTENANCE HISTORY SECTION                               -->
  <!-- ========================================================= -->
  <div class="section-container" style="margin-top: 2.5rem;">
    <div class="section-header-row">
      <div>
        <h2 class="section-heading">🛠️ Maintenance & Service History</h2>
        <p class="section-subheading">Track all historical repairs, calibrations, costs, and scheduled maintenance for this equipment.</p>
      </div>
      <a href="/maintenance/new?assetId=<%= asset._id %>" class="btn btn-primary btn-sm">
        <span class="btn-icon">➕</span> Log Service
      </a>
    </div>

    <div class="card table-card">
      <% if (typeof maintenanceLogs !== 'undefined' && maintenanceLogs && maintenanceLogs.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Service Date</th>
                <th>Cost (INR)</th>
                <th>Description</th>
                <th>Next Due Date</th>
                <th>Technician / Vendor</th>
                <th>Status</th>
                <th class="text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% maintenanceLogs.forEach(logItem => { %>
                <tr>
                  <td><%= new Date(logItem.serviceDate).toLocaleDateString() %></td>
                  <td class="font-bold text-success">₹<%= logItem.cost.toLocaleString() %></td>
                  <td>
                    <span class="truncate-text" title="<%= logItem.description %>">
                      <%= logItem.description %>
                    </span>
                  </td>
                  <td><strong><%= new Date(logItem.nextServiceDue).toLocaleDateString() %></strong></td>
                  <td><%= logItem.technician %></td>
                  <td>
                    <% if (logItem.status === 'Completed') { %>
                      <span class="badge badge-condition-ok">Completed</span>
                    <% } else if (logItem.status === 'In Progress') { %>
                      <span class="badge badge-condition-maintenance">In Progress</span>
                    <% } else { %>
                      <span class="badge badge-status-approved">Scheduled</span>
                    <% } %>
                  </td>
                  <td class="text-right">
                    <a href="/maintenance/<%= logItem._id %>" class="btn btn-sm btn-outline-primary">
                      View Log
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon">🔧</div>
          <p>No maintenance logs recorded for this asset yet.</p>
          <a href="/maintenance/new?assetId=<%= asset._id %>" class="btn btn-outline-primary btn-sm" style="margin-top: 0.75rem;">
            Log First Service Record
          </a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
