<%- include('../partials/header') %>

<div class="form-container-card">
  <div class="form-header">
    <a href="/assets" class="back-link">&larr; Back to Assets</a>
    <h1 class="form-title">➕ Add New Lab Asset</h1>
    <p class="form-subtitle">Enter the details to register new equipment or asset into the lab inventory.</p>
  </div>

  <form action="/assets" method="POST" class="asset-form">
    <div class="form-grid">
      <!-- Asset Tag -->
      <div class="form-group">
        <label for="assetTag" class="form-label">Asset Tag / Serial ID <span class="required">*</span></label>
        <input
          type="text"
          id="assetTag"
          name="assetTag"
          class="form-control"
          placeholder="e.g. OSC-101, MIC-204"
          value="<%= typeof formData !== 'undefined' && formData.assetTag ? formData.assetTag : '' %>"
          required
        >
        <small class="form-text">Must be a unique identifier for the equipment.</small>
      </div>

      <!-- Equipment Name -->
      <div class="form-group">
        <label for="name" class="form-label">Equipment Name <span class="required">*</span></label>
        <input
          type="text"
          id="name"
          name="name"
          class="form-control"
          placeholder="e.g. Digital Storage Oscilloscope"
          value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
          required
        >
      </div>

      <!-- Category -->
      <div class="form-group">
        <label for="category" class="form-label">Category <span class="required">*</span></label>
        <input
          type="text"
          id="category"
          name="category"
          class="form-control"
          placeholder="e.g. Electronics, Optics, Computing, Mechanical"
          value="<%= typeof formData !== 'undefined' && formData.category ? formData.category : '' %>"
          required
        >
      </div>

      <!-- Lab Location -->
      <div class="form-group">
        <label for="lab" class="form-label">Lab Location / Department <span class="required">*</span></label>
        <input
          type="text"
          id="lab"
          name="lab"
          class="form-control"
          placeholder="e.g. ECE Hardware Lab, Room 204"
          value="<%= typeof formData !== 'undefined' && formData.lab ? formData.lab : '' %>"
          required
        >
      </div>

      <!-- Equipment Condition -->
      <div class="form-group">
        <label for="condition" class="form-label">Condition <span class="required">*</span></label>
        <select id="condition" name="condition" class="form-control" required>
          <option value="OK" <%= (typeof formData !== 'undefined' && formData.condition === 'OK') ? 'selected' : '' %>>OK (Operational)</option>
          <option value="Maintenance" <%= (typeof formData !== 'undefined' && formData.condition === 'Maintenance') ? 'selected' : '' %>>Maintenance (Under Service)</option>
          <option value="Damaged" <%= (typeof formData !== 'undefined' && formData.condition === 'Damaged') ? 'selected' : '' %>>Damaged (Needs Repair)</option>
          <option value="Lost" <%= (typeof formData !== 'undefined' && formData.condition === 'Lost') ? 'selected' : '' %>>Lost (Unaccounted)</option>
        </select>
      </div>

      <!-- Total Quantity -->
      <div class="form-group">
        <label for="totalQuantity" class="form-label">Total Quantity <span class="required">*</span></label>
        <input
          type="number"
          id="totalQuantity"
          name="totalQuantity"
          class="form-control"
          min="0"
          placeholder="e.g. 10"
          value="<%= typeof formData !== 'undefined' && formData.totalQuantity !== undefined ? formData.totalQuantity : '' %>"
          required
        >
        <small class="form-text">Cannot be negative.</small>
      </div>

      <!-- Available Quantity -->
      <div class="form-group">
        <label for="availableQuantity" class="form-label">Available Quantity <span class="required">*</span></label>
        <input
          type="number"
          id="availableQuantity"
          name="availableQuantity"
          class="form-control"
          min="0"
          placeholder="e.g. 10"
          value="<%= typeof formData !== 'undefined' && formData.availableQuantity !== undefined ? formData.availableQuantity : '' %>"
          required
        >
        <small class="form-text">Cannot exceed total quantity.</small>
      </div>
    </div>

    <div class="form-actions">
      <a href="/assets" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Save Asset</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
